
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004eef2773957344212ba7d38a3af5a3ec0'
	option ula_prefix 'fd38::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'br-lan'
	list ports 'usb0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '60'
	list ipaddr '192.168.10.1/24'
	list ip6class 'local'
	option ip6ifaceid '::1'
	list ip6addr 'fd38::1/60'

config interface 'modem'
	option proto 'modemmanager'
	option device 'qcom-soc'
	option auth 'none'
	option iptype 'ipv4v6'
	option autoconnect '1'
	option auto '1'

config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'

config device
	option type 'bridge'
	option name 'docker0'

config interface 'wifi4'
	option proto 'dhcp'

config interface 'wifi6'
	option proto 'dhcpv6'
	option device 'wific'
	option norelease '1'
	option sourcefilter '0'

